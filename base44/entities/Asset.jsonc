{
  "name": "Asset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "type": {
      "type": "string",
      "enum": [
        "vehicle",
        "property",
        "equipment",
        "precious_metal",
        "collectible",
        "other"
      ],
      "default": "other",
      "title": "Type"
    },
    "value": {
      "type": "number",
      "default": 0,
      "title": "Value"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "institution": {
      "type": "string",
      "title": "Institution"
    },
    "interest_rate": {
      "type": "number",
      "title": "Interest Rate"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name",
    "type",
    "value"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}