{
  "name": "Goal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Goal Name"
    },
    "target_amount": {
      "type": "number",
      "default": 0,
      "title": "Target Amount"
    },
    "current_amount": {
      "type": "number",
      "default": 0,
      "title": "Current Amount"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "title": "Target Date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "title": "Priority"
    },
    "monthly_contribution": {
      "type": "number",
      "default": 0,
      "title": "Monthly Contribution Target"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name",
    "target_amount"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}