{
  "name": "Budget",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "title": "Category"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "title": "Budget Amount"
    },
    "period": {
      "type": "string",
      "enum": [
        "monthly",
        "weekly",
        "yearly"
      ],
      "default": "monthly",
      "title": "Period"
    },
    "rollover": {
      "type": "boolean",
      "default": false,
      "title": "Rollover"
    }
  },
  "required": [
    "category",
    "amount"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}