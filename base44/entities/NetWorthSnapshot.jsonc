{
  "name": "NetWorthSnapshot",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "assets": {
      "type": "number",
      "default": 0,
      "title": "Total Assets"
    },
    "liabilities": {
      "type": "number",
      "default": 0,
      "title": "Total Liabilities"
    },
    "net_worth": {
      "type": "number",
      "default": 0,
      "title": "Net Worth"
    },
    "source": {
      "type": "string",
      "default": "calculated",
      "title": "Source"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}